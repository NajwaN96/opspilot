# API listen address
OPSPILOT_ADDR=:8094

# Browser origins allowed to call the API directly.
# The Next.js dev server proxies /api, so these are only needed for direct calls.
OPSPILOT_CORS_ORIGINS=http://127.0.0.1:3461,http://localhost:3461

# How long each simulated rollback step stays active. 0 completes immediately.
OPSPILOT_REMEDIATION_STEP_MS=1400

# Where the Next.js server proxies /api, /health, and /ready.
API_PROXY_URL=http://127.0.0.1:8094

# PostgreSQL. Development-only credentials. Do not use these outside a local machine.
OPSPILOT_DATABASE_URL=postgres://opspilot:opspilot@127.0.0.1:5432/opspilot?sslmode=disable

# development enables POST /api/v1/demo/reset. production refuses it.
OPSPILOT_ENV=development

# Empty uses the default kubeconfig. Discovery stays read-only.
OPSPILOT_KUBECONFIG=
OPSPILOT_K8S_CLUSTER=opspilot-dev
OPSPILOT_K8S_NAMESPACES=demo-shop
OPSPILOT_SYNC_INTERVAL=15s

# Local demo token for the payment-api fault. Production disables the experiment controller.
# Must match the payment-fault Secret. Do not reuse this value anywhere but the laptop demo.
OPSPILOT_FAULT_TOKEN=opspilot-local-fault

# Separate database for repository tests. Unset skips those tests.
# OPSPILOT_TEST_DATABASE_URL=postgres://opspilot:opspilot@127.0.0.1:5432/opspilot_test?sslmode=disable
