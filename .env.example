# API listen address
OPSPILOT_ADDR=:8094

# Browser origins allowed to call the API directly.
# The Next.js dev server proxies /api, so these are only needed for direct calls.
OPSPILOT_CORS_ORIGINS=http://127.0.0.1:3461,http://localhost:3461

# How long each simulated rollback step stays active. 0 completes immediately.
OPSPILOT_REMEDIATION_STEP_MS=1400

# Where the Next.js server proxies /api and /health.
API_PROXY_URL=http://127.0.0.1:8094
