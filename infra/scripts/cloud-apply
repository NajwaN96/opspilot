#!/usr/bin/env bash
# Apply a previously written dev plan.
# Zero-cost mode refuses while the stack contains billable resources.
# Approval alone is not enough, and the paid override is not enabled here.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=lib/cost.sh
source "$ROOT/infra/scripts/lib/cost.sh"
guard_require_zero_cost "$ROOT"

# shellcheck source=lib/preflight.sh
source "$ROOT/infra/scripts/lib/preflight.sh"
cloud_preflight apply

STACK="$(cloud_stack_dir)"
cd "$STACK"
[[ -f tfplan ]] || {
  echo "cloud guard: no tfplan. Run cloud-plan first." >&2
  exit 1
}
tofu apply -input=false tfplan
rm -f tfplan
echo "applied opspilot-aws-dev"
